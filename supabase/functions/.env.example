# Edge function secrets for local development. Copy to supabase/functions/.env
# (git-ignored); `supabase start` and `supabase functions serve` load it.
# On a hosted project set the same names with
#   supabase secrets set --project-ref <ref> NAME=value ...
# SUPABASE_URL and the service key are injected by the runtime; do not set them.

# E-mail adapter: console (prints mail to the functions log) | brevo
EMAIL_PROVIDER=console
# Brevo transactional API key (xkeysib-…), only when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=

# The waitlist page. Mail links point at its /potwierdz/ and /wypisz/ pages,
# and its origin may call the functions from the browser.
WAITLIST_SITE_URL=http://localhost:8080
# More browser origins, comma-separated (optional; defaults to the site's origin).
WAITLIST_ALLOWED_ORIGINS=
# Public base URL of the functions, for the List-Unsubscribe header. Optional on
# hosted projects (derived from SUPABASE_URL); locally the injected URL is the
# Docker-internal one, so set the one a mail client could reach.
WAITLIST_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Sender of the waitlist mail. The domain must be verified with the mail provider.
WAITLIST_FROM_EMAIL=lista@example.com
WAITLIST_FROM_NAME=Rewizyta

# Key for hashing client IPs in the rate limiter. Any long random string;
# generate one per project: openssl rand -base64 32
WAITLIST_IP_SALT=local-development-only
