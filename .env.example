# Copy to .env (git-ignored) and pass to the app with:
#   flutter run --dart-define-from-file=.env      (from apps/mobile)
# Local values come from `supabase status` after `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-me

# Optional integrations. Leave empty to build with the no-op adapters.
# Sentry with EU data residency (https://sentry.io, region "EU") or a
# self-hosted GlitchTip; the DSN carries the region.
SENTRY_DSN=
# PostHog EU cloud (Frankfurt). The host is the EU ingest endpoint.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
